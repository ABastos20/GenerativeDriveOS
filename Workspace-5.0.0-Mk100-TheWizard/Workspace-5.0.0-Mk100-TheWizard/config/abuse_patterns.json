{
  "version": "11.4.0",
  "updated_at": "2025-12-10T00:00:00Z",
  "patterns": [
    {
      "id": "jailbreak_dan",
      "name": "DAN Mode / Ignore Instructions",
      "regex": "\\b(ignore previous instructions|do not follow|DAN mode|jailbreak)\\b",
      "category": "jailbreak",
      "severity": "critical",
      "action": "block"
    },
    {
      "id": "role_injection_root",
      "name": "Root/Admin Role Injection",
      "regex": "\\b(you are now|act as|simulate)\\s+(root|admin|system|developer)\\b",
      "category": "role_injection",
      "severity": "high",
      "action": "block"
    },
    {
      "id": "shell_chaining",
      "name": "Shell Command Chaining",
      "regex": "[;&|`]\\s*(sh|bash|cmd|powershell)|\\$\\(",
      "category": "shell_chaining",
      "severity": "high",
      "action": "block"
    },
    {
      "id": "tool_escalation_sudo",
      "name": "Sudo/Privilege Escalation",
      "regex": "\\b(sudo|su\\s+-|chmod|chown)\\b",
      "category": "tool_escalation",
      "severity": "critical",
      "action": "block"
    },
    {
      "id": "obfuscation_base64",
      "name": "Base64 Obfuscation",
      "regex": "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{2}==)?$",
      "category": "obfuscation",
      "severity": "medium",
      "action": "flag"
    },
    {
      "id": "TE001",
      "name": "Command Execution Request",
      "regex": "\\b(run|execute)\\s+command\\b",
      "category": "tool_escalation",
      "severity": "high",
      "action": "block"
    }
  ],
  "categories": [
    "jailbreak",
    "role_injection",
    "tool_escalation",
    "shell_chaining"
  ]
}
