# Optional overrides for docker/docker-compose.yml.
# All values have sane defaults; you only need to set these if you want to customize.

# Local Postgres
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=<your-dev-password>  # replace locally, do NOT commit real secrets

# Runtime behavior
JARVIS_ENV=development
JARVIS_LOG_FORMAT=json

# (Optional) External LLM provider keys – leave blank if not using yet
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
