  <integration-guides>
    <graylog>
      <description>Docker sidecar with GELF driver</description>
      <config>
logging:
  driver: gelf
  options:
    gelf-address: "udp://graylog:12201"
      </config>
    </graylog>
    <elk>
      <description>Filebeat for container logs</description>
      <config>
filebeat.inputs:
  - type: container
    json.keys_under_root: true
output.elasticsearch:
  hosts: ["elasticsearch:9200"]
  index: "jarvis-epistemic-%{+yyyy.MM.dd}"
      </config>
    </elk>
  </integration-guides>
