  <interfaces>
    <interface name="StdoutJsonSink" kind="class">
      <signature>
class StdoutJsonSink:
    def __init__(self, redact_content: bool = True): ...
    def handle_event(self, event: EpistemicEvent) -> None: ...
    def _redact(self, data: dict) -> dict: ...
      </signature>
      <path>src/jarvis/knowledge/audit_sinks.py</path>
    </interface>
    <interface name="create_audit_log_from_env" kind="factory">
      <signature>def create_audit_log_from_env() -> EpistemicAuditLog</signature>
      <path>src/jarvis/knowledge/audit.py</path>
    </interface>
  </interfaces>

  <constraints>
    <constraint type="security">Never log raw document text, LLM prompts, or PII</constraint>
    <constraint type="format">JSON lines format (one event per line)</constraint>
    <constraint type="compatibility">Must work with Graylog GELF and ELK Filebeat</constraint>
    <constraint type="dependency">Requires 11-5.2 Sink Architecture</constraint>
  </constraints>

  <tests>
