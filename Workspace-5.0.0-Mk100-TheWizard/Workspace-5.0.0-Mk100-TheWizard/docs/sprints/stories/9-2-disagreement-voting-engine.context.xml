  <story>
    <asA>governance participant</asA>
    <iWant>a structured voting system for resolving disagreements</iWant>
    <soThat>multiple humans can make collective decisions with clear rules and deadlines</soThat>
    <tasks>
      <task id="1">Create Proposal model with lifecycle state machine</task>
      <task id="2">Create Vote model with uniqueness constraint (one vote per user)</task>
      <task id="3">Implement vote casting with immutability</task>
      <task id="4">Build quorum and threshold checking</task>
      <task id="5">Create VoteCalculator for weighted vote tallying</task>
      <task id="6">Implement tie detection and escalation</task>
      <task id="7">Create proposal expiration background job</task>
      <task id="8">Build proposal and voting API endpoints</task>
    </tasks>
  </story>

