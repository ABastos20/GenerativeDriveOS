  &lt;story&gt;
    &lt;asA&gt;Jarvis developer optimizing retrieval performance&lt;/asA&gt;
    &lt;iWant&gt;recency/lineage filtering to happen at Qdrant query time via is_latest payload field&lt;/iWant&gt;
    &lt;soThat&gt;we don't over-fetch stale chunks as corpus scales beyond 1M chunks&lt;/soThat&gt;
    &lt;tasks&gt;
      &lt;task id="1"&gt;Add `is_latest` boolean field to Qdrant chunk payloads&lt;/task&gt;
      &lt;task id="2"&gt;Modify ingest pipeline to mark new versions is_latest=true, old as false&lt;/task&gt;
      &lt;task id="3"&gt;Add `version` integer column to documents table (Alembic migration)&lt;/task&gt;
      &lt;task id="4"&gt;Update Qdrant query filters to include is_latest=true by default&lt;/task&gt;
      &lt;task id="5"&gt;Implement backfill script for existing corpus&lt;/task&gt;
      &lt;task id="6"&gt;Ensure --allow-stale bypasses is_latest filter&lt;/task&gt;
      &lt;task id="7"&gt;Performance benchmarks (p50/p90 latency at scale)&lt;/task&gt;
    &lt;/tasks&gt;
  &lt;/story&gt;

  &lt;acceptanceCriteria&gt;
    &lt;criterion id="1"&gt;is_latest boolean field added to Qdrant chunk payloads&lt;/criterion&gt;
    &lt;criterion id="2"&gt;Ingest pipeline marks new versions as is_latest=true and old as false&lt;/criterion&gt;
    &lt;criterion id="3"&gt;Qdrant filter includes is_latest=true by default&lt;/criterion&gt;
